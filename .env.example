# Option A: OpenAI-compatible hosted endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace_with_your_own_key
OPENAI_MODEL=gpt-4o-mini

# Option B: local Ollama (comment out the hosted values above)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=qwen2.5:7b

# Demo webhook. Start webhook_receiver.py before enabling the following settings.
# CYBERGARDEN_WEBHOOK_ALLOW_LOOPBACK_DEMO=1
# CYBERGARDEN_WEBHOOK_DEMO_PORT=8767
# CYBERGARDEN_WEBHOOK_PROFILES={"demo":{"url":"http://127.0.0.1:8767/webhook"}}

# Example HTTPS profile with an optional token configured in the server environment.
# CYBERGARDEN_WEBHOOK_PROFILES={"audit":{"url":"https://hooks.example.org/cybergarden","tokenEnv":"CYBERGARDEN_WEBHOOK_TOKEN_AUDIT"}}

# Optional override for approved public training repositories (owner/repo and full commit SHA).
# CYBERGARDEN_TRAINING_REPOS={"TBagirov/training":"fe1fcbe212669783480666b9b60147c8a8c6eef4"}
